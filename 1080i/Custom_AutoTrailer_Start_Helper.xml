<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1195">

    <!-- AKL-only autoplay delay -->
    <visible>Skin.HasSetting(akl.autoplay.trailer) + $EXP[AKLGameBrowse] + !Player.HasMedia + !String.IsEmpty(ListItem.Trailer) + System.IdleTime(3) + !System.IdleTime(30)</visible>

    <!-- Start Background Fade -->
    <onload>SetProperty(TrailerFade,1,home)</onload>

    <!-- Set Trailer Path -->
    <onload>SetProperty(TrailerPath,$INFO[ListItem.Trailer],home)</onload>
    <onload>SetProperty(TrailerPath2,$INFO[ListItem.Trailer],home)</onload>
    <onload>SetProperty(AKLTrailerPath,$INFO[ListItem.Trailer],home)</onload>

    <!-- Start Trailer -->
    <onload>PlayMedia($INFO[ListItem.Trailer],1)</onload>
    <controls />
</window>
